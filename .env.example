# 仅供服务端读取。请复制为 .env.local 并填写真实密钥，禁止提交 .env.local。
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=90000

# 3D Agent 复用同一把 DeepSeek Key，将提示词实时生成为受限 Blender 脚本。

# 可选：为 AI 决策助手启用图片识别。支持 OpenAI 或 Anthropic 兼容协议，
# 图片先由视觉模型提取可见事实，再交给 DeepSeek 结合当前页面数据研判。
VISION_API_KEY=your_vision_api_key
VISION_MODEL=qwen3.7-plus
VISION_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_PROTOCOL=openai

# ArcGIS 前端底图 API Key。请在 ArcGIS 控制台限制允许的 HTTP Referrer。
VITE_ARCGIS_ACCESS_TOKEN=your_arcgis_api_key

# 生产服务监听配置（npm run start）
HOST=127.0.0.1
PORT=8080
BLENDER_EXECUTABLE=C:\Tools\blender-4.5.12-windows-x64\blender.exe
